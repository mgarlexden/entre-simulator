# 이 파일을 .env 로 복사해 값을 채웁니다. .env 는 .gitignore 에 있어 저장소에 올라가지 않습니다.
# 공공데이터포털(data.go.kr) 일반 인증키. pipelines/fetch_weather.py 가 기상청 일자료와 특일 정보를 받을 때 씁니다.
# API마다 활용신청을 따로 해야 합니다 (기상청 지상 일자료 15059093, 특일 정보 15012690).
DATA_GO_KR_KEY=

# KAMIS (농산물유통정보시스템) API 인증키
# data.go.kr에서 서비스 API 신청: 농산물도매시장 시세(12000, 채소·과일·수산물), 축산물수급 상황(12154, 소·돼지·닭)
# https://www.kamis.go.kr/ 또는 data.go.kr의 KAMIS 오픈API
KAMIS_API_KEY=
